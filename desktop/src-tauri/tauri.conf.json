{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "KeyboardCat",
  "version": "0.1.0",
  "identifier": "com.keyboardcat.desktop",
  "build": {
    "frontendDist": "../web"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "键盘猫",
        "width": 1160,
        "height": 860,
        "transparent": true,
        "decorations": false,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "focus": false,
        "visible": false,
        "url": "index.html",
        "dragDropEnabled": false
      },
      {
        "label": "panel",
        "title": "键盘猫 面板",
        "width": 775,
        "height": 548,
        "transparent": true,
        "decorations": false,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "center": true,
        "visible": false,
        "url": "index.html",
        "dragDropEnabled": false
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico"
    ]
  }
}